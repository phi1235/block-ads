# ==============================================================================
# ReelGuard Environment Configuration & Key Management
# ==============================================================================

# Custom Keystore Configuration (Optional - Defaults to Dynamic Android KeyStore)
REELGUARD_SIGNER_ALIAS=reelguard
REELGUARD_SIGNER_PASSWORD=your_secure_password_here
REELGUARD_KEYSTORE_PATH=

# Custom Signing Key Base64 (Optional)
REELGUARD_PRIVATE_KEY_BASE64=
REELGUARD_CERT_BASE64=

# Upstream DNS Server (Default: Cloudflare 1.1.1.1)
REELGUARD_UPSTREAM_DNS=1.1.1.1